# Copy to .env and adjust. docker-compose reads this file too.

# --- Database -------------------------------------------------------------
POSTGRES_USER=mgs
POSTGRES_PASSWORD=mgs
POSTGRES_DB=mgs
POSTGRES_PORT=5433
MGS_DATABASE_URL=postgresql+psycopg://mgs:mgs@localhost:5433/mgs

# --- API ------------------------------------------------------------------
MGS_API_HOST=0.0.0.0
MGS_API_PORT=8000
MGS_LOG_LEVEL=INFO
# Comma-separated keys accepted on writing endpoints (ingest, passes, alert
# acknowledgement). Leave empty and every write is open to anyone who can reach
# the port — the API warns at startup and /health reports "auth: disabled".
# Several keys are allowed so a feed can be rotated without an outage.
MGS_API_KEYS=dev-station-key

# --- Anomaly worker -------------------------------------------------------
MGS_POLL_INTERVAL_SECONDS=10
MGS_BATTERY_MIN_V=6.8
MGS_BATTERY_CRITICAL_V=6.4
MGS_TEMP_MAX_C=60.0
MGS_TEMP_MIN_C=-30.0
MGS_ENABLE_ML=true
MGS_ML_TRAINING_WINDOW_HOURS=24
MGS_ML_MIN_SAMPLES=50
MGS_ML_CONTAMINATION=0.02
MGS_ZSCORE_THRESHOLD=3.0
# A condition must stay quiet this long before its alert resolves. Without it a
# single normal frame mid-excursion closes the episode and the next one opens
# another: measured at 7 reopenings inside 5 minutes on a day of real data.
MGS_ALERT_CLEAR_AFTER_SECONDS=120

# --- Retention ------------------------------------------------------------
# Delete screened telemetry older than this many days. 0 keeps everything,
# which is the safe default and not a sustainable one: about 2.3 GB per
# satellite-year at the default cadence. Frames cited by an alert are evidence
# and are never deleted. Run with `mgs-retention`, from cron or a scheduled
# container.
MGS_RETENTION_DAYS=0

# --- Ground station -------------------------------------------------------
MGS_STATION_ID=HANOI-GS
MGS_STATION_LAT_DEG=21.0278
MGS_STATION_LON_DEG=105.8342
MGS_STATION_ELEVATION_M=20
# Below this the spacecraft is behind terrain, not merely low in the sky.
MGS_STATION_MIN_ELEVATION_DEG=5.0

# --- Simulator ------------------------------------------------------------
MGS_SIM_API_URL=http://localhost:8000
# The key the simulator presents when downlinking. Match one of MGS_API_KEYS.
MGS_SIM_API_KEY=dev-station-key
# Empty means "use the name in the element set".
MGS_SIM_SATELLITE_ID=
# NORAD catalog number to fly. 25544 is the ISS.
MGS_SIM_CATALOG_NUMBER=25544
# How much mission time one run covers.
MGS_SIM_DURATION=24h
# Simulated seconds per second of wall clock: 600 replays a day in four minutes.
MGS_SIM_TIME_SCALE=600
# Simulated seconds between recorded housekeeping frames.
MGS_SIM_RECORD_INTERVAL_SECONDS=30
# Frames per simulated second the downlink moves while in contact.
MGS_SIM_DOWNLINK_RATE=2.0
# Frames the on-board recorder holds before overwriting the oldest.
MGS_SIM_ONBOARD_CAPACITY=4096
# Probability a frame is lost on the downlink.
MGS_SIM_DROP_RATE=0.02
# Expected number of injected faults per orbit (battery sag / thermal spike).
MGS_SIM_FAULT_RATE=1.5
